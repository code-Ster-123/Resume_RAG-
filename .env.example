# ========================================================
# LLM Configuration (Swappable Provider & OpenAI Compatible)
# ========================================================

# 1. Google Gemini via OpenAI-Compatible Endpoint (Recommended Default)
LLM_PROVIDER=openai_like
LLM_MODEL=gemini-1.5-flash
LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Or OpenAI directly:
# LLM_PROVIDER=openai_like
# LLM_MODEL=gpt-4o-mini
# LLM_API_BASE=https://api.openai.com/v1
# OPENAI_API_KEY=your_openai_api_key_here

# 3. Or Groq:
# LLM_PROVIDER=openai_like
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_BASE=https://api.groq.com/openai/v1
# LLM_API_KEY=your_groq_api_key_here

# 4. Or Local Ollama:
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# LLM_API_BASE=http://localhost:11434

# ========================================================
# RAG Configuration
# ========================================================
EMBED_MODEL=BAAI/bge-base-en-v1.5
PDF_PATH=data/Utkarsh_Ujwal_Gen_AI_Engineer_Resume.pdf

# ========================================================
# Semantic Caching Configuration
# ========================================================
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.88
SEMANTIC_CACHE_FILE=data/semantic_cache.json
SEMANTIC_CACHE_MAX_ENTRIES=1000

